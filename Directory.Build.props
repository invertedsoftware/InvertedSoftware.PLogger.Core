<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <Authors>Inverted Software</Authors>
    <Company>Inverted Software</Company>
    <Copyright>Copyright (c) Inverted Software. Licensed under Apache-2.0.</Copyright>
    <PackageProjectUrl>https://github.com/invertedsoftware/InvertedSoftware.PLogger.Core</PackageProjectUrl>
    <RepositoryUrl>https://github.com/invertedsoftware/InvertedSoftware.PLogger.Core</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageLicenseFile></PackageLicenseFile>

    <Version>2.0.0-preview.1</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
  </PropertyGroup>

</Project>

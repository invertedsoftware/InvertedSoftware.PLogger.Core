<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>InvertedSoftware.PLogger.Diagnostics.SqlServer</RootNamespace>
    <AssemblyName>InvertedSoftware.PLogger.Diagnostics.SqlServer</AssemblyName>
    <IsPackable>true</IsPackable>
    <!--
      Microsoft.Data.SqlClient is not AOT-safe (dynamic SNI provider load,
      reflection in the ADO.NET command path). Match the AI / Agents / Mcp
      packages here so consumer publish-AOT signals correctly flag the
      transitive constraint.
    -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>

    <PackageId>InvertedSoftware.PLogger.Diagnostics.SqlServer</PackageId>
    <Description>SQL Server 2025 backing store for PLogger diagnostics. Fingerprint-keyed dedup + occurrence counting today; VECTOR(N) similarity search lights up in InvertedSoftware.PLogger.Diagnostics.AI.</Description>
    <PackageTags>logging;diagnostics;sqlserver;vector;plogger</PackageTags>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InvertedSoftware.PLogger.Diagnostics\InvertedSoftware.PLogger.Diagnostics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Schema\0001_initial.sql" />
  </ItemGroup>

</Project>

[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache files
.vs/
*.user
*.userosscache
*.sln.docstates
*.suo

# Tools
.dotnet/
.vscode/
.idea/
.claude/

# NuGet
*.nupkg
*.snupkg
.nuget/
packages/
*.nuget.props
*.nuget.targets

# BenchmarkDotNet output
BenchmarkDotNet.Artifacts/

# Test results
TestResults/
*.trx
coverage*.json
coverage*.xml
coverage*.info
*.coverage

# OS
.DS_Store
Thumbs.db

# Sample-app runtime artefacts
samples/**/plogger*.txt

# AOT/PublishOutput
publish/
